# Copy this file to .env and fill in your values
# NEVER commit .env to git

SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-here
DEBUG=False

MONGODB_URI=# Email settings for OTP delivery via SendGrid (HTTPS REST API)
# Works on Render (no SMTP needed), sends through SendGrid REST API
GMAIL_CLIENT_ID=your_gmail_oauth_client_id_here
GMAIL_CLIENT_SECRET=your_gmail_oauth_client_secret_here
GMAIL_REFRESH_TOKEN=your_gmail_oauth_refresh_token_here
SMTP_FROM=your_email@gmail.com

GOOGLE_GEMINI_API_KEY=your-gemini-key
WEATHER_API_KEY=your-weather-key
