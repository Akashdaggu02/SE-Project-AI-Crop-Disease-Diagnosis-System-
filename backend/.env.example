# ============================================================
# AI Crop Diagnosis System - Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.

# --- Database ---
MONGODB_URI=your_mongodb_connection_string_here
MONGODB_DB_NAME=crop_diagnosis_db

# --- Security ---
SECRET_KEY=change_this_to_a_random_secret_key
JWT_SECRET_KEY=change_this_to_a_random_jwt_secret

# --- Google Gemini AI (Chatbot & Crop ID) ---
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# --- Email (OTP Delivery via Resend) ---
# Render blocks SMTP ports — use Resend (HTTPS) instead. Free: 3,000 emails/month.
# 1. Sign up at https://resend.com → get your API key
# 2. Verify a sender domain OR use onboarding@resend.dev for testing
# 3. Set the variables below in your Render dashboard Environment tab
RESEND_API_KEY=re_your_api_key_here
SMTP_FROM=onboarding@resend.dev

# --- Weather API ---
WEATHER_API_KEY=your_openweathermap_api_key

# --- App Settings ---
DEBUG=True
HOST=0.0.0.0
PORT=5000
